{#
/**
 * @file
 * Header Icon Link component. Styled by .site-header__icon in the Site Header.
 */
#}
<a{{ attributes.addClass('site-header__icon', 'site-header__icon-link') }} href="{{ url }}">
  <span class="visually-hidden">{{ label }}</span>
  {% if icon == 'mail' %}
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 4h20v16H2V4zm2 2v.5l8 5 8-5V6H4zm16 2.8-8 5-8-5V18h16V8.8z" fill="currentColor"/></svg>
  {% elseif icon == 'phone' %}
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" fill="currentColor"/></svg>
  {% elseif icon == 'user' %}
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-4.4 0-9 2.2-9 5v3h18v-3c0-2.8-4.6-5-9-5z" fill="currentColor"/></svg>
  {% elseif icon == 'location' %}
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" fill="currentColor"/></svg>
  {% endif %}
</a>
