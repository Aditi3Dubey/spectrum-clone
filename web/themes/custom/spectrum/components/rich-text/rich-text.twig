{#
/**
 * @file
 * Rich Text component.
 */
#}
{# Spacing props: add a utility class from css/utilities/spacing.css. #}
{% set spacing = [] %}
{% if space_above in ['small', 'medium', 'large'] %}
  {% set spacing = spacing|merge(['space-above--' ~ space_above]) %}
{% endif %}
{% if space_below in ['small', 'medium', 'large'] %}
  {% set spacing = spacing|merge(['space-below--' ~ space_below]) %}
{% endif %}

{% if color.cssVariable|default %}
  {% set attributes = attributes.setAttribute('style', 'color: var(' ~ color.cssVariable ~ ')') %}
{% elseif color.cssColorValue|default %}
  {% set attributes = attributes.setAttribute('style', 'color: ' ~ color.cssColorValue) %}
{% endif %}

<div{{ attributes.addClass(['rich-text']|merge(spacing)) }}>{{ text }}</div>
