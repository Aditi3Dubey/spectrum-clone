{#
/**
 * @file
 * Contact Section component.
 */
#}
{% set srcset = panel_image.src ? panel_image.src|toSrcSet(panel_image.width) : null %}

<section{{ attributes.addClass('contact-section') }}>
  {% if notice %}
    <div class="contact-section__notice">
      <div class="container">{{ notice }}</div>
    </div>
  {% endif %}

  <div class="contact-section__main container">
    <h2 class="contact-section__heading">{{ heading }}</h2>

    <div class="contact-section__box">
      <div class="contact-section__form">
        {% block form %}{% endblock %}
      </div>

      <aside class="contact-section__panel">
        {% if panel_image.src %}
          <img class="contact-section__panel-image"
               src="{{ panel_image.src }}"
               {% if srcset %}srcset="{{ srcset }}" sizes="(min-width: 992px) 350px, 100vw"{% endif %}
               alt=""
               loading="lazy">
        {% endif %}
        <div class="contact-section__panel-content">
          <span class="contact-section__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24"><path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2.4V17h14V7.4l-7 5-7-5ZM6.4 7 12 11l5.6-4H6.4Z" fill="currentColor"/></svg>
          </span>
          {% if panel_heading %}
            <h3 class="contact-section__panel-heading">{{ panel_heading }}</h3>
          {% endif %}
          {% if panel_text %}
            <p class="contact-section__panel-text">{{ panel_text }}</p>
          {% endif %}
        </div>
      </aside>
    </div>
  </div>
</section>
