{#
/**
 * @file
 * Industry Card component.
 */
#}
{% set srcset = image.src ? image.src|toSrcSet(image.width) : null %}

<article{{ attributes.addClass('industry-card') }}>
  {% if image.src %}
    <img class="industry-card__image"
         src="{{ image.src }}"
         {% if srcset %}srcset="{{ srcset }}" sizes="100vw"{% endif %}
         alt="{{ image.alt }}"
         {% if image.width %}width="{{ image.width }}"{% endif %}
         {% if image.height %}height="{{ image.height }}"{% endif %}
         loading="lazy">
  {% endif %}

  <div class="industry-card__main container">
    <div class="industry-card__content">
      <span class="industry-card__line" aria-hidden="true"></span>

      <div class="industry-card__text">
        <h3 class="industry-card__heading">{{ heading }}</h3>
        {% if text %}
          <p class="industry-card__description">{{ text }}</p>
        {% endif %}
      </div>

      {% if url %}
        <a class="btn" href="{{ url }}">
          {{ link_label|default('Learn More') }}
          <span class="visually-hidden">{{ 'about'|t }} {{ heading }}</span>
          <svg class="btn__icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M7 0 5.8 1.2l4.9 4.9H0v1.8h10.7l-4.9 4.9L7 14l7-7z" fill="currentColor"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</article>
