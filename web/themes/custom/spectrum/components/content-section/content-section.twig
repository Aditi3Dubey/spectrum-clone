{#
/**
 * @file
 * Content Section component.
 */
#}
{% set background = background in ['white', 'grey'] ? background : 'white' %}
{% set alignment = alignment in ['left', 'center'] ? alignment : 'left' %}
{% set padding_top = padding_top in ['none', 'small', 'medium', 'large'] ? padding_top : 'medium' %}
{% set padding_bottom = padding_bottom in ['none', 'small', 'medium', 'large'] ? padding_bottom : 'medium' %}
{% set gap = gap in ['small', 'medium', 'large'] ? gap : 'medium' %}

{% set classes = [
  'content-section',
  'content-section--' ~ background,
  'content-section--' ~ alignment,
  'content-section--pt-' ~ padding_top,
  'content-section--pb-' ~ padding_bottom,
  'content-section--gap-' ~ gap,
] %}

<section{{ attributes.addClass(classes) }}>
  <div class="content-section__inner container">
    {% block content %}{% endblock %}
  </div>
</section>
