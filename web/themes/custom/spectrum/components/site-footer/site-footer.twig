{#
/**
 * @file
 * Site Footer component.
 */
#}
<footer{{ attributes.addClass('site-footer') }}>
  <div class="container">

    <div class="site-footer__top">
      <a class="site-footer__logo" href="{{ home_url|default('/') }}" rel="home">
        <img src="{{ logo.src }}" alt="{{ logo.alt|default('Home') }}" width="{{ logo.width|default(179) }}" height="{{ logo.height|default(40) }}" loading="lazy">

      </a>

      <ul class="site-footer__social">
        {% block social %}{% endblock %}
      </ul>
    </div>

    <div class="site-footer__menu">
      <ul class="footer-menu">
        {% block menu %}{% endblock %}
      </ul>
    </div>

    <div class="site-footer__bottom">
      {% if copyright %}
        <p class="site-footer__copyright">{{ copyright }}</p>
      {% endif %}
      <ul class="legal-menu">
        {% block legal %}{% endblock %}
      </ul>
    </div>

  </div>
</footer>
