{#
/**
 * @file
 * Header Menu Item component.
 *
 * The slot is rendered once into a variable, so we can check whether it has
 * any content and print it without rendering it twice.
 */
#}
{% set columns_markup = columns|render %}
{% set has_children = columns_markup|striptags|trim is not empty %}
{% set panel_id = 'mega-panel-' ~ random() %}

{% set classes = ['main-menu__item'] %}
{% if has_children %}
  {% set classes = classes|merge(['main-menu__item--parent']) %}
{% endif %}

<li{{ attributes.addClass(classes) }}>
  {% if has_children %}
    <button class="main-menu__link main-menu__toggle" type="button" aria-expanded="false" aria-controls="{{ panel_id }}">
      {{ title }}
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1.4 3.6 6 8.2l4.6-4.6" stroke="currentColor" stroke-width="1.6" fill="none"/></svg>
    </button>

    <div class="main-menu__panel" id="{{ panel_id }}">
      <div class="main-menu__panel-inner container">
        {% if url and explore_text %}
          <a class="main-menu__explore" href="{{ url }}">
            {{ explore_text }}
            {{ include('spectrum:icon', { name: 'arrow', size: 14 }, with_context = false) }}
          </a>
        {% endif %}
        <ul class="main-menu__columns">
          {{ columns_markup }}
        </ul>
      </div>
    </div>
  {% elseif url %}
    <a class="main-menu__link" href="{{ url }}">{{ title }}</a>
  {% else %}
    <span class="main-menu__link">{{ title }}</span>
  {% endif %}
</li>
