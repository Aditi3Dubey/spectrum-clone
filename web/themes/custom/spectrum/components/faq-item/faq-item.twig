{#
/**
 * @file
 * FAQ Item component.
 */
#}
<details{{ attributes.addClass('faq-item') }}{{ open ? ' open' }}>
  <summary class="faq-item__question">
    <span class="faq-item__question-text">{{ question }}</span>
    <svg class="faq-item__icon" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
      <path d="M4.5 6.75 9 11.25l4.5-4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </summary>
  {% if answer %}
    <div class="faq-item__answer">{{ answer }}</div>
  {% endif %}
</details>
