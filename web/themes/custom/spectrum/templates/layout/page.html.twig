{#
/**
 * @file
 * Page layout for the Spectrum theme.
 * Header and footer are global; Canvas fills the content region.
 */
#}
<div class="layout-container">

  {{ page.header }}
  {{ page.primary_menu }}

  {{ page.breadcrumb }}
  {{ page.highlighted }}

  <main id="main-content" role="main">
    {{ page.content }}
  </main>

  {{ page.footer_menu }}
  {{ page.footer }}

</div>
